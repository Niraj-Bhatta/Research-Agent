# --- Pick ONE provider: gemini | groq | openrouter | ollama | anthropic ---
LLM_PROVIDER=gemini

# Keys (fill in the one you use)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=optional
OPENROUTER_API_KEY=optional
ANTHROPIC_API_KEY=optional

# Search API Key (Tavily free tier)
TAVILY_API_KEY=your_tavily_api_key_here

# Model Overrides
LLM_MODEL=gemini-flash-lite-latest
# LLM_BASE_URL=http://host.docker.internal:11434/v1   # for Ollama inside Docker

# Agent Configuration
MAX_REVISIONS=2
DEDUP_THRESHOLD=0.85
OUTPUT_DIR=outputs
